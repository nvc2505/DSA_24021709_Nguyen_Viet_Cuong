void merge (int *a, int l, int m, int r) {
    int *b, *c;
    b = new int [m - l + 1];
    c = new int [r - m];
    
    for (int i = l; i <= r; i++) {
        if (i <= m) b[i - l] = a[i];
        else c[i - m - 1] = a[i];
    }

    int i = 0, j = 0;
    int k = l;

    while (i < m - l + 1 && j < r - m) {
        if (b[i] < c[j]) a[k] = b[i++];
        else a[k] = c[j++];
        k++;
    }
    
    while (i < m - l + 1) {
        a[k++] = b[i++];
    }

    while (j < r - m) {
        a[k++] = c[j++];
    }

    delete[] b;
    delete[] c;
}
